# Copy to `.env` and fill in values. Never commit `.env`.

# -----------------------------------------------------------------------------
# Server & database (Express, Mongoose, scripts)
# -----------------------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/your-db-name

# Required in production — used to sign JWTs for auth
JWT_SECRET=change-me-to-a-long-random-string

# Canonical public URL (SEO routes, sitemap script). Defaults to https://techtrendsai.in if unset.
SITE_URL=http://localhost:3000

# HTTP port for production `npm start` (default: 3000)
PORT=3000

# Optional — response body for GET /api/ping (default: "ping")
# PING_MESSAGE=ping

# -----------------------------------------------------------------------------
# Client (Vite — exposed to the browser; only VITE_* vars are bundled)
# -----------------------------------------------------------------------------
# Should match SITE_URL in production for correct canonical/OG URLs in the SPA
VITE_SITE_URL=http://localhost:5173
